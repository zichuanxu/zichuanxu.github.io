---
layout: null
permalink: /feed.xml
sitemap: false
---
<?xml version="1.0" encoding="utf-8"?>
<feed xmlns="http://www.w3.org/2005/Atom">
  <title>Zichuan Xu: Blog</title>
  <link href="{{ site.url }}/feed.xml" rel="self" type="application/atom+xml" />
  <link href="{{ site.url }}/blog/" rel="alternate" type="text/html" />
  <id>{{ site.url }}/blog/</id>
  <updated>{{ site.time | date_to_xmlschema }}</updated>
  <author><name>Zichuan Xu</name><uri>{{ site.url }}/</uri></author>
  {%- for post in site.posts limit: 20 %}
  <entry>
    <title>{{ post.title | xml_escape }}</title>
    <link href="{{ site.url }}{{ post.url }}" rel="alternate" type="text/html" />
    <id>{{ site.url }}{{ post.url }}</id>
    <published>{{ post.date | date_to_xmlschema }}</published>
    <updated>{{ post.updated | default: post.date | date_to_xmlschema }}</updated>
    {%- if post.description %}
    <summary>{{ post.description | xml_escape }}</summary>
    {%- endif %}
    <content type="html">{{ post.content | xml_escape }}</content>
  </entry>
  {%- endfor %}
</feed>
